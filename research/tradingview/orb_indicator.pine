//@version=5
// =====================================================================
// OR5 INDIKÁTOR — range první 5-min svíčky (9:30-9:35 ET) — Strong Chicken
//   Úroveň z Projektu 7 (Level Edge Study): OR5 high/low jsou REÁLNÉ
//   reaktivní úrovně (bounce ~58-60 % vs náhoda 52 %, z>3).
//   Data favorizují FADE (reverzi) na OR5 extrémech; breakout je proti
//   tendenci — proto oba módy na výběr.
//   SL = buffer za úrovní, TP = RR × riziko. Max 1 obchod/den, EOD flat.
// POUŽIJ 1-min nebo 5-min chart, ES/NQ futures.
// =====================================================================
indicator("OR5 (9:30-9:35) — Strong Chicken", overlay=true, max_lines_count=100, max_labels_count=100)

mode    = input.string("Fade", "Mód", options=["Fade", "Breakout"],
     tooltip="Fade = reverze na dotek OR5 (datově sedící, Projekt 7). Breakout = průraz OR5 (proti tendenci).")
rr      = input.float(1.5, "TP jako RR × riziko", minval=0.1, step=0.1)
slBuf   = input.float(1.5, "SL buffer (body za úrovní)", minval=0.0, step=0.25)
tz = "America/New_York"
GRN = color.new(color.lime, 0)
RED = color.new(color.red, 0)
TEAL= color.new(color.teal, 0)

inOR5     = not na(time(timeframe.period, "0930-0935", tz))
afterOR5  = not na(time(timeframe.period, "0935-1600", tz))
eod       = not na(time(timeframe.period, "1559-1600", tz))
newSess   = (hour(time,tz)==18 and minute(time,tz)==0) and not (hour(time,tz)[1]==18 and minute(time,tz)[1]==0)

// ===== OR5 range (9:30-9:35) =====
var float rHi = na
var float rLo = na
var bool traded = false
if inOR5 and not inOR5[1]      // 9:30 start
    rHi := high
    rLo := low
    traded := false
else if inOR5
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)

var int pos = 0
var float slLvl = na
var float tpLvl = na
var line rHiLine = na
var line rLoLine = na
var line slLine = na
var line tpLine = na
longSig = false
shortSig = false
exitSig = false

// nakresli OR5 čáry po dokončení (9:35)
if afterOR5 and not afterOR5[1] and not na(rHi)
    if not na(rHiLine)
        line.delete(rHiLine)
        line.delete(rLoLine)
    rHiLine := line.new(bar_index, rHi, bar_index+1, rHi, extend=extend.right, color=TEAL, width=2)
    rLoLine := line.new(bar_index, rLo, bar_index+1, rLo, extend=extend.right, color=TEAL, width=2)

canSig = not na(rHi) and not traded and pos == 0 and afterOR5
d = 0
entryPx = close
if mode == "Breakout"
    if canSig and close > rHi
        d := 1
        slLvl := rLo - slBuf
    else if canSig and close < rLo
        d := -1
        slLvl := rHi + slBuf
else   // Fade — reverze na dotek OR5 extrému
    if canSig and high >= rHi
        d := -1                       // dotek horní hrany → short zpět do range
        slLvl := rHi + slBuf
    else if canSig and low <= rLo
        d := 1                        // dotek dolní hrany → long
        slLvl := rLo - slBuf

if d != 0
    traded := true
    dir = d
    risk = math.abs(entryPx - slLvl)
    tpLvl := entryPx + dir * rr * risk
    if risk > 0
        pos := dir
        longSig := dir == 1
        shortSig := dir == -1
        if not na(slLine)
            line.delete(slLine)
            line.delete(tpLine)
        slLine := line.new(bar_index, slLvl, bar_index+1, slLvl, extend=extend.right, color=RED, width=2)
        tpLine := line.new(bar_index, tpLvl, bar_index+1, tpLvl, extend=extend.right, color=GRN, width=2)

// ===== exit: SL / TP / EOD =====
if pos != 0
    hitSL = pos == 1 ? low <= slLvl : high >= slLvl
    hitTP = pos == 1 ? high >= tpLvl : low <= tpLvl
    if hitSL or hitTP or eod
        exitSig := true
        pos := 0

if newSess
    if not na(rHiLine)
        line.delete(rHiLine)
        line.delete(rLoLine)
        rHiLine := na
        rLoLine := na
    if not na(slLine)
        line.delete(slLine)
        line.delete(tpLine)
        slLine := na
        tpLine := na

// ===== vizualizace =====
bgcolor(inOR5 ? color.new(color.blue, 88) : na, title="OR5 zóna (9:30-9:35)")
plotshape(longSig,  "LONG",  shape.triangleup,   location.belowbar, GRN, size=size.small, text="LONG")
plotshape(shortSig, "SHORT", shape.triangledown, location.abovebar, RED, size=size.small, text="SHORT")
plotshape(exitSig,  "EXIT",  shape.xcross,       location.abovebar, color.new(color.gray,0), size=size.tiny)

alertcondition(longSig,  "OR5 LONG",  "OR5: long signál")
alertcondition(shortSig, "OR5 SHORT", "OR5: short signál")
alertcondition(exitSig,  "OR5 EXIT",  "OR5: výstup (SL/TP/EOD)")
