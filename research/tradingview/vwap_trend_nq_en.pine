//@version=5
// =====================================================================
// NQ VWAP Trend (hysteresis band) — Strong Chicken, Project 3, v5.1 EN
// FINAL CONFIGURATION from research (phases A–E, IS 2018–2025):
//   entry from 9:31, session VWAP RTH, band b = 20 bps, 1 trade/day,
//   exit = close beyond the opposite band / EOD 16:00, NO TP (Band
//   mode), + TWO GATES (IS: Sharpe 1.40, MDD −6.4%, positive all 8 yrs):
//     GAP GATE:   do not trade when |overnight gap| < 25th percentile
//                 of the last 250 days (small gap = no-energy day)
//     TREND GATE: do not trade the day AFTER a strongly trending day —
//                 when yesterday's |close−open|/(high−low) > 60th
//                 percentile of the last 250 days
//
// NEW in v5.1: the gate percentiles are computed from DAILY RTH bars
//   via request.security — the full 250-day window works IMMEDIATELY,
//   independent of the 1-minute chart depth and your TV plan's bar
//   limit. No 60-day wait. (NQ1! daily history spans years.)
//   No lookahead: today's gap is fixed from 9:30 (open vs yesterday's
//   RTH close); trendiness comes from YESTERDAY's CLOSED daily bar [1].
//
//   - today is a no-trade day -> red NO TRADE DAY banner in the corner
//     (with the reason: gap / trend / gap+trend)
//   - historical no-trade days -> red label at the 9:30 candle
//     (drawn retroactively, never shown for the current day)
//
// TWO EXIT MODES (switch): default = "Band (no TP)" (final config).
//   * "Band (no TP)" = exit only on a close beyond the opposite band /
//     EOD; SL side of the band red, trade-direction side green.
//   * "TP (fixed target)" = additionally exit at entry ± 74.375 pts
//     (intrabar touch); short entry/SL/TP lines as trade history.
//
// NOTES: 1-MIN chart of NQ (NQ1!). Sizing (VT15) at account level.
// =====================================================================
indicator("NQ VWAP Trend (b=20bps) — Strong Chicken v5.1", overlay=true, max_lines_count=500, max_labels_count=500)

mode       = input.string("Band (no TP)", "Exit mode", options=["Band (no TP)", "TP (fixed target)"],
     tooltip="Band = final configuration from research (no TP, winners run). TP = fixed target ±74.375 pts, higher win-rate, lower total return.")
bandBps    = input.float(20.0, "Hysteresis band (bps)", minval=0.0, step=2.5,
     tooltip="Frozen strategy value = 20 bps. Do not change without re-validation.")
tpPoints   = input.float(74.375, "TP distance (points) — TP mode only", minval=0.0, step=0.25)
useGate    = input.bool(true,  "Gap gate (skip low-gap days)",
     tooltip="Do not trade days with |overnight gap| below the percentile of the last 250 days.")
gatePct    = input.float(25.0, "Gap gate percentile", minval=0.0, maxval=90.0, step=5.0,
     tooltip="Recommended plateau center = 25 (works 15–30).")
usePtGate  = input.bool(true,  "Trend gate (skip days after a trending day)",
     tooltip="Do not trade the day after a strongly trending day: yesterday's |close−open|/(high−low) above the percentile. From the closing run: MDD −15.7% -> −6.4%.")
ptPct      = input.float(60.0, "Trend gate percentile", minval=10.0, maxval=95.0, step=5.0)
showBands  = input.bool(true,  "Show VWAP±b bands")
showSigma  = input.bool(false, "Show VWAP σ-deviation bands (±1σ, ±2σ) — context only")
showInfo   = input.bool(true,  "Info panel")

useTP = mode == "TP (fixed target)"

TZ   = "America/New_York"
SESS = "0930-1600"

inSess  = not na(time(timeframe.period, SESS, TZ))
newSess = inSess and not inSess[1]
eodBar  = inSess and hour(time, TZ) == 15 and minute(time, TZ) == 59

// ---- GATES v5.1: percentiles from DAILY RTH bars (request.security) ----
// RTH version of the symbol -> daily open/close correspond to 9:30/16:00
rthTicker = ticker.modify(syminfo.tickerid, session.regular)
// today's gap: |today's open / yesterday's close − 1| — both fixed from 9:30,
// the value does NOT change during the day -> lookahead_on is safe here (no repaint)
gapRank = request.security(rthTicker, "D",
     ta.percentrank(math.abs(open / close[1] - 1) * 10000, 250),
     lookahead=barmerge.lookahead_on)
// YESTERDAY's trendiness: taken from the CLOSED daily bar [1] -> no repaint
ptRank = request.security(rthTicker, "D",
     ta.percentrank((high - low) > 0 ? math.abs(close - open) / (high - low) : na, 250)[1],
     lookahead=barmerge.lookahead_on)

var bool  allowedToday = true
var bool  prevAllowed = true
var string gateReason = ""
var int   sessStartBar = na
var float sessStartHigh = na

if newSess
    // 1) retro label for YESTERDAY (so it never shows for the current day)
    if (useGate or usePtGate) and not prevAllowed and not na(sessStartBar)
        label.new(sessStartBar, sessStartHigh, "NO TRADE DAY",
             color=color.new(color.red, 10), textcolor=color.white,
             style=label.style_label_down, size=size.small)
    // 2) evaluate the gates from the daily percentiles
    bool gapOK = not useGate or na(gapRank) or gapRank >= gatePct
    bool ptOK  = not usePtGate or na(ptRank) or ptRank <= ptPct
    allowedToday := gapOK and ptOK
    gateReason := not gapOK and not ptOK ? "gap+trend" : not gapOK ? "gap" : not ptOK ? "trend" : ""
    prevAllowed := allowedToday
    sessStartBar := bar_index
    sessStartHigh := high

// ---- session VWAP (RTH-only, HLC3, daily reset) + variance for σ bands ----
var float cumPV  = na
var float cumV   = na
var float cumPV2 = na
if newSess
    cumPV  := 0.0
    cumV   := 0.0
    cumPV2 := 0.0
if inSess
    cumPV  += hlc3 * volume
    cumV   += volume
    cumPV2 += hlc3 * hlc3 * volume
vwap = inSess and cumV > 0 ? cumPV / cumV : na
varv = inSess and cumV > 0 ? math.max(cumPV2 / cumV - vwap * vwap, 0.0) : na
sd   = na(varv) ? na : math.sqrt(varv)

b  = bandBps / 10000.0
up = vwap * (1 + b)
dn = vwap * (1 - b)

// ---- position state (one trade/day; exit per mode; gates) ----
var int   pos = 0
var bool  tradedToday = false
var float entryPx = na
var float slFix   = na
var float tpFix   = na
longSig  = false
shortSig = false
exitSig  = false          // exit at opposite band or EOD
tpSig    = false          // exit at TP (TP mode only)

if newSess
    pos := 0
    tradedToday := false

if inSess and not na(vwap)
    if eodBar
        if pos != 0
            exitSig := true
            pos := 0
    else
        if pos == 0
            if not tradedToday and allowedToday       // 1 entry/day + gates
                if close > up
                    pos := 1
                    longSig := true
                    tradedToday := true
                else if close < dn
                    pos := -1
                    shortSig := true
                    tradedToday := true
        else
            tpHit = useTP and not na(tpFix) and (pos == 1 ? high >= tpFix : low <= tpFix)
            if tpHit
                tpSig := true   // TP touch = real exit (TP mode only)
                pos := 0
            else if pos == 1 and close < dn
                exitSig := true  // close (no reverse — 1 trade/day)
                pos := 0
            else if pos == -1 and close > up
                exitSig := true  // close (no reverse — 1 trade/day)
                pos := 0

// ---- drawing ----
plot(vwap, "VWAP (RTH)", color=color.new(color.orange, 0), linewidth=2)

// bands in Band mode with an open trade: SL side RED,
// trade-direction side (where price should keep closing) GREEN
slUpActive = not useTP and pos == -1     // short -> SL = upper band
slDnActive = not useTP and pos == 1      // long  -> SL = lower band
tpUpActive = not useTP and pos == 1      // long  -> green = upper band
tpDnActive = not useTP and pos == -1     // short -> green = lower band
pUp  = plot(showBands ? up : na, "VWAP + b", color=slUpActive ? color.new(color.red, 20) : tpUpActive ? color.new(color.green, 20) : color.new(color.teal, 55), linewidth=2)
pDn  = plot(showBands ? dn : na, "VWAP − b", color=slDnActive ? color.new(color.red, 20) : tpDnActive ? color.new(color.green, 20) : color.new(color.teal, 55), linewidth=2)
fill(pUp, pDn, color=color.new(color.teal, 95))

// ---- SHORT entry/SL/TP lines — TP mode only (trade history, never deleted) ----
var line   enLine  = na
var line   slLine  = na
var line   tpLine  = na
var bool   trActive = false

// extend ONLY the lines of the current (live) trade
if trActive and not na(slLine)
    line.set_x2(enLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tpLine, bar_index)

if (longSig or shortSig) and useTP
    dir     = longSig ? 1 : -1
    entryPx := close
    slFix   := dir == 1 ? dn : up          // opposite band at entry time (frozen)
    tpFix   := entryPx + dir * tpPoints     // TP exactly ± tpPoints
    enLine  := line.new(bar_index, entryPx, bar_index, entryPx, color=color.new(color.blue, 0),  width=1)
    slLine  := line.new(bar_index, slFix,   bar_index, slFix,   color=color.new(color.red, 0),   width=2)
    tpLine  := line.new(bar_index, tpFix,   bar_index, tpFix,   color=color.new(color.green, 0), width=2)
    trActive := true

if (exitSig or tpSig) and not na(slLine)    // finish at the exit bar, do NOT delete
    line.set_x2(enLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tpLine, bar_index)
    trActive := false
    entryPx := na
    slFix   := na
    tpFix   := na

// optional σ-deviation bands (context ONLY — the strategy does not use them)
plot(showSigma ? vwap + sd     : na, "VWAP +1σ", color=color.new(color.purple, 65))
plot(showSigma ? vwap - sd     : na, "VWAP −1σ", color=color.new(color.purple, 65))
plot(showSigma ? vwap + 2 * sd : na, "VWAP +2σ", color=color.new(color.purple, 80))
plot(showSigma ? vwap - 2 * sd : na, "VWAP −2σ", color=color.new(color.purple, 80))

// entries + exits for EVERY trade (both modes)
plotshape(longSig,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small, text="BUY")
plotshape(shortSig, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small, text="SELL")
plotshape(tpSig,    "TP EXIT", shape.diamond,   location.abovebar, color.new(color.green, 0), size=size.small, text="TP")
plotshape(exitSig,  "EXIT", shape.xcross,       location.abovebar, color.new(color.gray, 0),  size=size.small, text="EXIT")

bgcolor(pos == 1 ? color.new(color.green, 94) : pos == -1 ? color.new(color.red, 94) : na)

// ---- RED corner banner for TODAY's no-trade day (with the reason) ----
var table ntT = table.new(position.top_left, 1, 1)
if barstate.islast
    if (useGate or usePtGate) and not allowedToday
        table.cell(ntT, 0, 0, "  NO TRADE DAY (" + gateReason + ")  ", text_color=color.white,
             bgcolor=color.new(color.red, 10), text_size=size.normal)
    else
        table.cell(ntT, 0, 0, "", bgcolor=color.new(color.white, 100), text_size=size.tiny)

// ---- info panel ----
slShow = useTP ? slFix : (pos == 1 ? dn : pos == -1 ? up : na)
var table t = table.new(position.top_right, 2, 7, border_width=1)
if showInfo and barstate.islast
    table.cell(t, 0, 0, "Mode",     text_size=size.small), table.cell(t, 1, 0, useTP ? "TP" : "Band", text_size=size.small)
    table.cell(t, 0, 1, "Gates",    text_size=size.small), table.cell(t, 1, 1, not (useGate or usePtGate) ? "off" : allowedToday ? "OK — trade" : "NO TRADE (" + gateReason + ")", text_size=size.small, text_color=not (useGate or usePtGate) ? color.gray : allowedToday ? color.green : color.red)
    table.cell(t, 0, 2, "Position", text_size=size.small), table.cell(t, 1, 2, pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT", text_size=size.small, text_color=pos == 1 ? color.green : pos == -1 ? color.red : color.gray)
    table.cell(t, 0, 3, "VWAP",     text_size=size.small), table.cell(t, 1, 3, na(vwap) ? "—" : str.tostring(vwap, format.mintick), text_size=size.small)
    table.cell(t, 0, 4, useTP ? "SL (fixed)" : "SL (band)", text_size=size.small), table.cell(t, 1, 4, na(slShow) ? "—" : str.tostring(slShow, format.mintick), text_size=size.small, text_color=color.red)
    table.cell(t, 0, 5, "TP",       text_size=size.small), table.cell(t, 1, 5, not useTP ? "— (Band mode)" : na(tpFix) ? "—" : str.tostring(tpFix, format.mintick) + "  (±" + str.tostring(tpPoints) + "pt)", text_size=size.small, text_color=color.green)
    table.cell(t, 0, 6, "Sizing",   text_size=size.small), table.cell(t, 1, 6, "VT15 (off-chart)", text_size=size.small)

// ---- alerts ----
alertcondition(longSig,  "VWAP Trend BUY",      "NQ VWAP Trend: BUY (enter at next candle open)")
alertcondition(shortSig, "VWAP Trend SELL",     "NQ VWAP Trend: SELL (enter at next candle open)")
alertcondition(tpSig,    "VWAP Trend TP EXIT",  "NQ VWAP Trend: TP hit — exit")
alertcondition(exitSig,  "VWAP Trend EXIT",     "NQ VWAP Trend: exit (opposite band / 16:00 ET)")
alertcondition(newSess and not allowedToday, "VWAP Trend NO TRADE DAY", "NQ VWAP Trend: today is a NO TRADE DAY (gap/trend gate)")
