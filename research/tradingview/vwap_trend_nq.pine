//@version=5
// =====================================================================
// NQ VWAP Trend (hysterezní pásmo) — Strong Chicken, Projekt 3, v2
// Věrná implementace zamrazené strategie z r3_frozen_spec.md:
//   - session VWAP (RTH 9:30–16:00 ET, HLC3 × volume, denní reset)
//   - hysterezní pásmo b = 20 bps: LONG když close > VWAP×(1+b),
//     SHORT když close < VWAP×(1−b); návrat k VWAP nic nespouští
//   - JEN 1 TRADE/DEN: close za OPAČNÝM pásmem = zavřít (bez otočení),
//     další vstup až následující den
//   - EOD: vše flat na close 16:00 ET; žádné overnight pozice
//
// POZNÁMKY:
//   * 1-MINUTOVÝ chart NQ (např. NQ1!). Skript filtruje RTH sám.
//   * Backtest plnil na OPEN NÁSLEDUJÍCÍ svíčky po signálu.
//   * Exit = close za opačným pásmem nebo 16:00 ET; pak už nový trade
//     ten den nevznikne (1 trade/den).
//   * σ-deviation bandy VWAPu jsou jen VOLITELNÝ KONTEXT (default off)
//     — strategie je NEPOUŽÍVÁ, SL je fixní 20bps pásmo.
//   * Sizing VT15 na úrovni účtu (r3_frozen_spec.md §3), ne na chartu.
// =====================================================================
indicator("NQ VWAP Trend (b=20bps) — Strong Chicken v2", overlay=true, max_lines_count=500, max_labels_count=500)

bandBps    = input.float(20.0, "Hysterezní pásmo (bps)", minval=0.0, step=2.5,
     tooltip="Zamrazená hodnota strategie = 20 bps. Neměň bez nové validace.")
tpPoints   = input.float(74.375, "TP vzdálenost (body)", minval=0.0, step=0.25,
     tooltip="Fixní TP čára = entry ± tato vzdálenost (poloviční, 74.375 b). Pozn.: zamrazená strategie fixní TP NEMÁ (exit = flip/EOD); tohle je vizuální TP.")
showBands  = input.bool(true,  "Zobrazit pásma VWAP±b (kontext)")
showSigma  = input.bool(false, "Zobrazit σ-deviation bandy VWAP (±1σ, ±2σ) — jen kontext")
showInfo   = input.bool(true,  "Info panel")

TZ   = "America/New_York"
SESS = "0930-1600"

inSess  = not na(time(timeframe.period, SESS, TZ))
newSess = inSess and not inSess[1]
eodBar  = inSess and hour(time, TZ) == 15 and minute(time, TZ) == 59

// ---- session VWAP (RTH-only, HLC3, reset denně) + rozptyl pro σ bandy ----
var float cumPV  = na
var float cumV   = na
var float cumPV2 = na
if newSess
    cumPV  := 0.0
    cumV   := 0.0
    cumPV2 := 0.0
if inSess
    cumPV  += hlc3 * volume
    cumV   += volume
    cumPV2 += hlc3 * hlc3 * volume
vwap = inSess and cumV > 0 ? cumPV / cumV : na
varv = inSess and cumV > 0 ? math.max(cumPV2 / cumV - vwap * vwap, 0.0) : na
sd   = na(varv) ? na : math.sqrt(varv)

b  = bandBps / 10000.0
up = vwap * (1 + b)
dn = vwap * (1 - b)

// ---- poziční stav (jen 1 trade/den, bez stop-and-reverse) ----
var int  pos = 0
var bool tradedToday = false
longSig  = false
shortSig = false
exitSig  = false

if newSess
    pos := 0
    tradedToday := false

if inSess and not na(vwap)
    if eodBar
        if pos != 0
            exitSig := true
            pos := 0
    else
        if pos == 0
            if not tradedToday                 // jen 1 vstup denně
                if close > up
                    pos := 1
                    longSig := true
                    tradedToday := true
                else if close < dn
                    pos := -1
                    shortSig := true
                    tradedToday := true
        else if pos == 1 and close < dn
            exitSig := true     // zavřít (bez otočení — 1 trade/den)
            pos := 0
        else if pos == -1 and close > up
            exitSig := true     // zavřít (bez otočení — 1 trade/den)
            pos := 0

// ---- vykreslení ----
plot(vwap, "VWAP (RTH)", color=color.new(color.orange, 0), linewidth=2)

// pásma jen jako NEUTRÁLNÍ kontext (SL se už NEkreslí jako pohyblivé pásmo)
pUp  = plot(showBands ? up : na, "VWAP + b", color=color.new(color.teal, 55))
pDn  = plot(showBands ? dn : na, "VWAP − b", color=color.new(color.teal, 55))
fill(pUp, pDn, color=color.new(color.teal, 95))

// ---- KRÁTKÉ čáry: ENTRY (modrá) + SL (červená, zamrazená) + TP (zelená, ±tpPoints) ----
//      rostou entry→exit a ZŮSTÁVAJÍ jako historie trades (žádné mazání, žádné nekonečno)
var line   enLine  = na
var line   slLine  = na
var line   tpLine  = na
var bool   trActive = false
var float  entryPx = na
var float  slFix   = na
var float  tpFix   = na

// prodluž čáry POUZE aktuálního (živého) trade
if trActive and not na(slLine)
    line.set_x2(enLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tpLine, bar_index)

if longSig or shortSig
    dir     = longSig ? 1 : -1
    entryPx := close
    slFix   := dir == 1 ? dn : up          // opačné pásmo v okamžiku vstupu (zamrazené)
    tpFix   := entryPx + dir * tpPoints     // TP přesně ±148.75 bodu (input)
    enLine  := line.new(bar_index, entryPx, bar_index, entryPx, color=color.new(color.blue, 0),  width=1)
    slLine  := line.new(bar_index, slFix,   bar_index, slFix,   color=color.new(color.red, 0),   width=2)
    tpLine  := line.new(bar_index, tpFix,   bar_index, tpFix,   color=color.new(color.green, 0), width=2)
    trActive := true

if exitSig and not na(slLine)               // dokresli po exit bar, ale NEMAŽ
    line.set_x2(enLine, bar_index)
    line.set_x2(slLine, bar_index)
    line.set_x2(tpLine, bar_index)
    trActive := false
    entryPx := na
    slFix   := na
    tpFix   := na

// volitelné σ-deviation bandy (JEN kontext — strategie je nepoužívá)
plot(showSigma ? vwap + sd     : na, "VWAP +1σ", color=color.new(color.purple, 65))
plot(showSigma ? vwap - sd     : na, "VWAP −1σ", color=color.new(color.purple, 65))
plot(showSigma ? vwap + 2 * sd : na, "VWAP +2σ", color=color.new(color.purple, 80))
plot(showSigma ? vwap - 2 * sd : na, "VWAP −2σ", color=color.new(color.purple, 80))

plotshape(longSig,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small, text="BUY")
plotshape(shortSig, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small, text="SELL")
plotshape(exitSig,  "EOD EXIT", shape.xcross,   location.abovebar, color.new(color.gray, 0),  size=size.small, text="EOD")

bgcolor(pos == 1 ? color.new(color.green, 94) : pos == -1 ? color.new(color.red, 94) : na)

// ---- info panel ----
var table t = table.new(position.top_right, 2, 5, border_width=1)
if showInfo and barstate.islast
    table.cell(t, 0, 0, "Pozice",   text_size=size.small), table.cell(t, 1, 0, pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT", text_size=size.small, text_color=pos == 1 ? color.green : pos == -1 ? color.red : color.gray)
    table.cell(t, 0, 1, "VWAP",     text_size=size.small), table.cell(t, 1, 1, na(vwap) ? "—" : str.tostring(vwap, format.mintick), text_size=size.small)
    table.cell(t, 0, 2, "SL (pevný)", text_size=size.small), table.cell(t, 1, 2, na(slFix) ? "—" : str.tostring(slFix, format.mintick), text_size=size.small, text_color=color.red)
    table.cell(t, 0, 3, "TP",       text_size=size.small), table.cell(t, 1, 3, na(tpFix) ? "—" : str.tostring(tpFix, format.mintick) + "  (±" + str.tostring(tpPoints) + "b)", text_size=size.small, text_color=color.green)
    table.cell(t, 0, 4, "Sizing",   text_size=size.small), table.cell(t, 1, 4, "VT15 (mimo chart)", text_size=size.small)

// ---- alerty ----
alertcondition(longSig,  "VWAP Trend BUY",      "NQ VWAP Trend: BUY (vstup na open další svíčky)")
alertcondition(shortSig, "VWAP Trend SELL",     "NQ VWAP Trend: SELL (vstup na open další svíčky)")
alertcondition(exitSig,  "VWAP Trend EOD EXIT", "NQ VWAP Trend: EOD flat (16:00 ET)")
