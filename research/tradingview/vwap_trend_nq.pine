//@version=5
// =====================================================================
// NQ VWAP Trend (hysterezní pásmo) — Strong Chicken, Projekt 3, v2
// Věrná implementace zamrazené strategie z r3_frozen_spec.md:
//   - session VWAP (RTH 9:30–16:00 ET, HLC3 × volume, denní reset)
//   - hysterezní pásmo b = 20 bps: LONG když close > VWAP×(1+b),
//     SHORT když close < VWAP×(1−b); návrat k VWAP nic nespouští
//   - stop-and-reverse: close za OPAČNÝM pásmem = zavřít + otočit
//     -> v otevřeném trade se SL strana pásma kreslí ČERVENĚ
//   - EOD: vše flat na close 16:00 ET; žádné overnight pozice
//
// POZNÁMKY:
//   * 1-MINUTOVÝ chart NQ (např. NQ1!). Skript filtruje RTH sám.
//   * Backtest plnil na OPEN NÁSLEDUJÍCÍ svíčky po signálu.
//   * Fixní TP neexistuje: exit = flip (červené pásmo) nebo 16:00 ET.
//   * σ-deviation bandy VWAPu jsou jen VOLITELNÝ KONTEXT (default off)
//     — strategie je NEPOUŽÍVÁ, SL je fixní 20bps pásmo.
//   * Sizing VT15 na úrovni účtu (r3_frozen_spec.md §3), ne na chartu.
// =====================================================================
indicator("NQ VWAP Trend (b=20bps) — Strong Chicken v2", overlay=true, max_labels_count=500)

bandBps    = input.float(20.0, "Hysterezní pásmo (bps)", minval=0.0, step=2.5,
     tooltip="Zamrazená hodnota strategie = 20 bps. Neměň bez nové validace.")
showBands  = input.bool(true,  "Zobrazit pásma VWAP±b")
showSigma  = input.bool(false, "Zobrazit σ-deviation bandy VWAP (±1σ, ±2σ) — jen kontext")
showInfo   = input.bool(true,  "Info panel")

TZ   = "America/New_York"
SESS = "0930-1600"

inSess  = not na(time(timeframe.period, SESS, TZ))
newSess = inSess and not inSess[1]
eodBar  = inSess and hour(time, TZ) == 15 and minute(time, TZ) == 59

// ---- session VWAP (RTH-only, HLC3, reset denně) + rozptyl pro σ bandy ----
var float cumPV  = na
var float cumV   = na
var float cumPV2 = na
if newSess
    cumPV  := 0.0
    cumV   := 0.0
    cumPV2 := 0.0
if inSess
    cumPV  += hlc3 * volume
    cumV   += volume
    cumPV2 += hlc3 * hlc3 * volume
vwap = inSess and cumV > 0 ? cumPV / cumV : na
varv = inSess and cumV > 0 ? math.max(cumPV2 / cumV - vwap * vwap, 0.0) : na
sd   = na(varv) ? na : math.sqrt(varv)

b  = bandBps / 10000.0
up = vwap * (1 + b)
dn = vwap * (1 - b)

// ---- poziční stav (přesně dle frozen spec) ----
var int pos = 0
longSig  = false
shortSig = false
exitSig  = false

if newSess
    pos := 0

if inSess and not na(vwap)
    if eodBar
        if pos != 0
            exitSig := true
            pos := 0
    else
        if pos == 0
            if close > up
                pos := 1
                longSig := true
            else if close < dn
                pos := -1
                shortSig := true
        else if pos == 1 and close < dn
            pos := -1
            shortSig := true    // stop & reverse: long -> short
        else if pos == -1 and close > up
            pos := 1
            longSig := true     // stop & reverse: short -> long

// ---- vykreslení ----
plot(vwap, "VWAP (RTH)", color=color.new(color.orange, 0), linewidth=2)

// pásma: neutrální teal, ale SL strana v otevřeném trade ČERVENĚ (tlustě)
upIsSL = pos == -1   // v shortu je SL horní pásmo
dnIsSL = pos == 1    // v longu je SL dolní pásmo
pUp  = plot(showBands ? up : na, "VWAP + b", color=upIsSL ? na : color.new(color.teal, 40))
pDn  = plot(showBands ? dn : na, "VWAP − b", color=dnIsSL ? na : color.new(color.teal, 40))
plot(showBands and upIsSL ? up : na, "SL pásmo (short)", color=color.new(color.red, 0), linewidth=3, style=plot.style_linebr)
plot(showBands and dnIsSL ? dn : na, "SL pásmo (long)",  color=color.new(color.red, 0), linewidth=3, style=plot.style_linebr)
fill(pUp, pDn, color=color.new(color.teal, 94))

// volitelné σ-deviation bandy (JEN kontext — strategie je nepoužívá)
plot(showSigma ? vwap + sd     : na, "VWAP +1σ", color=color.new(color.purple, 65))
plot(showSigma ? vwap - sd     : na, "VWAP −1σ", color=color.new(color.purple, 65))
plot(showSigma ? vwap + 2 * sd : na, "VWAP +2σ", color=color.new(color.purple, 80))
plot(showSigma ? vwap - 2 * sd : na, "VWAP −2σ", color=color.new(color.purple, 80))

plotshape(longSig,  "BUY",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small, text="BUY")
plotshape(shortSig, "SELL", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small, text="SELL")
plotshape(exitSig,  "EOD EXIT", shape.xcross,   location.abovebar, color.new(color.gray, 0),  size=size.small, text="EOD")

bgcolor(pos == 1 ? color.new(color.green, 94) : pos == -1 ? color.new(color.red, 94) : na)

// ---- info panel ----
var table t = table.new(position.top_right, 2, 5, border_width=1)
if showInfo and barstate.islast
    slLvl = pos == 1 ? dn : pos == -1 ? up : na
    table.cell(t, 0, 0, "Pozice",   text_size=size.small), table.cell(t, 1, 0, pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT", text_size=size.small, text_color=pos == 1 ? color.green : pos == -1 ? color.red : color.gray)
    table.cell(t, 0, 1, "VWAP",     text_size=size.small), table.cell(t, 1, 1, na(vwap) ? "—" : str.tostring(vwap, format.mintick), text_size=size.small)
    table.cell(t, 0, 2, "SL (S&R)", text_size=size.small), table.cell(t, 1, 2, na(slLvl) ? "—" : str.tostring(slLvl, format.mintick), text_size=size.small, text_color=color.red)
    table.cell(t, 0, 3, "TP",       text_size=size.small), table.cell(t, 1, 3, "žádný — exit 16:00 ET / flip", text_size=size.small)
    table.cell(t, 0, 4, "Sizing",   text_size=size.small), table.cell(t, 1, 4, "VT15 (mimo chart)", text_size=size.small)

// ---- alerty ----
alertcondition(longSig,  "VWAP Trend BUY",      "NQ VWAP Trend: BUY (vstup na open další svíčky)")
alertcondition(shortSig, "VWAP Trend SELL",     "NQ VWAP Trend: SELL (vstup na open další svíčky)")
alertcondition(exitSig,  "VWAP Trend EOD EXIT", "NQ VWAP Trend: EOD flat (16:00 ET)")
