//@version=5
// =====================================================================
// REAKTIVNÍ ÚROVNĚ ES — jen ověřené (Projekt 7, Level Edge Study)
//   ZELENÉ (bounce, číst flow pro fade):  OR5 high, OR5 low, VWAP -2σ
//   ČERVENÁ (through/magnet, continuation): session POC
// Session kotva = 18:00 ET (Globex open). Pusť na ES/NQ futures (NQ1!/ES1!),
//   intradenní timeframe (1-5 min). OR5 = high/low první 5-min svíčky 9:30-9:35.
// =====================================================================
indicator("Reaktivní úrovně (OR5 / VWAP-2σ / POC)", overlay=true, max_labels_count=20)

// ===== Nastavení =====
showOR5   = input.bool(true,  "OR5 high/low  (zelená, bounce)")
showV2    = input.bool(true,  "VWAP -2σ      (zelená, bounce)")
showV3    = input.bool(false, "VWAP +3σ      (zelená, marginální)")
showPOC   = input.bool(true,  "POC           (červená, through)")
showVWAP  = input.bool(false, "VWAP střed    (jen kontext)")
pocBin    = input.float(1.0,  "POC bin (body ES)", minval=0.25, step=0.25)
tz        = "America/New_York"
GRN = color.new(color.lime, 0)
GRN2= color.new(color.green, 45)
RED = color.new(color.red, 0)

// ===== Session anchor (18:00 ET = start denní svíčky CME futures) =====
newSession = ta.change(time("D")) != 0

// ===== Session VWAP + σ pásma =====
[vwapVal, _u2, lo2] = ta.vwap(hlc3, newSession, 2.0)
[_v3, up3, _l3]     = ta.vwap(hlc3, newSession, 3.0)

// ===== OR5 = high/low první 5-min svíčky 9:30-9:35 ET =====
inOR5    = not na(time(timeframe.period, "0930-0935", tz))
or5start = inOR5 and not inOR5[1]
var float or5h = na
var float or5l = na
if newSession
    or5h := na
    or5l := na
if or5start
    or5h := high
    or5l := low
else if inOR5
    or5h := math.max(or5h, high)
    or5l := math.min(or5l, low)

// ===== Session POC (developing volume profile) =====
var map<float, float> vp = map.new<float, float>()
if newSession
    map.clear(vp)
bin  = math.round(hlc3 / pocBin) * pocBin
prev = map.get(vp, bin)
map.set(vp, bin, (na(prev) ? 0.0 : prev) + volume)
float best  = -1.0
float bestk = na
for k in map.keys(vp)
    vv = map.get(vp, k)
    if vv > best
        best := vv
        bestk := k
poc = bestk

// ===== Vykreslení =====
plot(showOR5 ? or5h : na,  "OR5 High",  color=GRN,  linewidth=2, style=plot.style_linebr)
plot(showOR5 ? or5l : na,  "OR5 Low",   color=GRN,  linewidth=2, style=plot.style_linebr)
plot(showV2  ? lo2  : na,  "VWAP -2σ",  color=GRN,  linewidth=2)
plot(showV3  ? up3  : na,  "VWAP +3σ",  color=GRN2, linewidth=1)
plot(showPOC ? poc  : na,  "POC",       color=RED,  linewidth=2)
plot(showVWAP? vwapVal:na, "VWAP",      color=color.new(color.gray, 55), linewidth=1)

// ===== Popisky na poslední svíčce =====
if barstate.islast
    if showOR5 and not na(or5h)
        label.new(bar_index, or5h, "OR5 High", color=na, textcolor=GRN, style=label.style_label_left, size=size.small)
        label.new(bar_index, or5l, "OR5 Low",  color=na, textcolor=GRN, style=label.style_label_left, size=size.small)
    if showV2 and not na(lo2)
        label.new(bar_index, lo2, "VWAP -2σ", color=na, textcolor=GRN, style=label.style_label_left, size=size.small)
    if showPOC and not na(poc)
        label.new(bar_index, poc, "POC", color=na, textcolor=RED, style=label.style_label_left, size=size.small)

// ===== Alerty na dotek =====
alertcondition(showOR5 and not na(or5h) and high >= or5h and low <= or5h, "Dotek OR5 High", "Cena na OR5 High")
alertcondition(showOR5 and not na(or5l) and high >= or5l and low <= or5l, "Dotek OR5 Low",  "Cena na OR5 Low")
alertcondition(showV2  and not na(lo2)  and high >= lo2  and low <= lo2,  "Dotek VWAP -2σ", "Cena na VWAP -2σ")
alertcondition(showPOC and not na(poc)  and high >= poc  and low <= poc,  "Dotek POC",      "Cena na POC")
